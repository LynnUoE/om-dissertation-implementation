# Copy to backend/.env and fill in your values
OPENAI_API_KEY=your_openai_api_key

# Optional: use any OpenAI-compatible provider instead of OpenAI.
# The model must support tool calling (agent search) and the temperature parameter.
# Example for Volcano Engine Ark: LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3,
# LLM_API_KEY=<Ark API key>, LLM_MODEL=<Ark model or endpoint ID>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o
# Max LLM calls per agent search (the last call must answer)
AGENT_MAX_STEPS=6

# Pipeline search retrieval (see eval/results.md for how the options compare)
# multi_query: several focused OpenAlex searches, then rerank; single_query: the original pipeline
RETRIEVAL_STRATEGY=multi_query
# none | embedding[:model] | cross-encoder[:Hugging Face model]
RERANKER=cross-encoder:cross-encoder/ms-marco-MiniLM-L-6-v2
# Weight (0-1) of a citation-count prior in the final ranking
RERANK_CITATION_WEIGHT=0.1
# Also consider papers co-cited by the top results (one extra OpenAlex request per search)
CITATION_EXPANSION=false
# Rerank the agent's search results too
AGENT_RERANK=false

# Sent to OpenAlex for its "polite pool" (faster, more reliable)
RESEARCHER_EMAIL=your_email@example.com
# Optional but recommended: OpenAlex rate-limits anonymous search under load.
# Free key: https://openalex.org (sign up, then copy the key from your account settings)
OPENALEX_API_KEY=
STATIC_FOLDER=../frontend
DEBUG=True
# macOS AirPlay Receiver occupies port 5000, so default to 5001
PORT=5001
