# Copy to backend/.env and fill in your values
OPENAI_API_KEY=your_openai_api_key
# Sent to OpenAlex for its "polite pool" (faster, more reliable)
RESEARCHER_EMAIL=your_email@example.com
# Optional but recommended: OpenAlex rate-limits anonymous search under load.
# Free key: https://openalex.org (sign up, then copy the key from your account settings)
OPENALEX_API_KEY=
STATIC_FOLDER=../frontend
DEBUG=True
# macOS AirPlay Receiver occupies port 5000, so default to 5001
PORT=5001
