# Copy to deploy/.env on the server (see docs/deploy-ec2.md). Never commit it.

# Public address of the site: a domain whose A record points to the server's Elastic IP,
# or <ip-with-dashes>.sslip.io (e.g. 3-14-15-92.sslip.io for 3.14.15.92), which needs no DNS setup
SITE_ADDRESS=litfinder.example.com

# MCP clients must send "Authorization: Bearer <MCP_TOKEN>". At least 32 characters;
# generate one with: openssl rand -hex 32
MCP_TOKEN=
